<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Avatar conversationnel</title>
  <style>
    html, body { margin: 0; padding: 0; height: 100%; background: black; overflow: hidden; }
    #avatarVideo {
      width: 100vw;
      height: 100vh;
      object-fit: contain;   /* <-- affiche la vidéo entière, sans zoom */
    }
    #status {
      position: absolute;
      bottom: 16px;
      left: 16px;
      color: white;
      font-family: sans-serif;
      font-size: 14px;
      background: rgba(0,0,0,0.5);
      padding: 6px 12px;
      border-radius: 6px;
    }
  </style>
</head>
<body>
  <video id="avatarVideo" autoplay playsinline></video>
  <div id="status">Connexion…</div>

  <script src="https://cdn.jsdelivr.net/npm/livekit-client/dist/livekit-client.umd.min.js"></script>
  <script>
    // ⚠️ À REGÉNÉRER À CHAQUE TEST (voir commande dans le terminal)
    const LIVEKIT_URL = "wss://test-vjsyazm0.livekit.cloud";
    const LIVEKIT_TOKEN = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJBUElkZHNMckpXRWtZUDUiLCJzdWIiOiJzcGVjdGF0ZXVyIiwiZXhwIjoxNzkwNzkyNjA0LCJuYmYiOjE3OTA3MDYyMDQsImlhdCI6MTc5MDcwNjIwNCwiaWRlbnRpdHkiOiJzcGVjdGF0ZXVyIiwibmFtZSI6InNwZWN0YXRldXIiLCJ2aWRlbyI6eyJyb29tSm9pbiI6dHJ1ZSwicm9vbSI6Im1hLXNhbGxlLXRlc3QifX0.sl9Q-VVT5O5OU9xxBbuyRKAQqsgJDKon6zWS-7pK7lI";

    const statusEl = document.getElementById("status");
    const videoEl = document.getElementById("avatarVideo");

    const room = new LivekitClient.Room();

    // ⚠️ Écouteur AVANT connect()
    room.on(LivekitClient.RoomEvent.TrackSubscribed, (track) => {
      if (track.kind === "video") {
        track.attach(videoEl);
        statusEl.textContent = "Avatar connecté ✅";
      }
      if (track.kind === "audio") {
        track.attach(); // joue l'audio automatiquement
      }
    });

    room.on(LivekitClient.RoomEvent.Disconnected, () => {
      statusEl.textContent = "Déconnecté ❌ — rechargez ou relancez l'agent";
    });

    (async () => {
      try {
        await room.connect(LIVEKIT_URL, LIVEKIT_TOKEN);
        statusEl.textContent = "Connecté — en attente de l'avatar…";

        // Active le micro automatiquement
        await room.localParticipant.setMicrophoneEnabled(true);
      } catch (err) {
        console.error(err);
        statusEl.textContent = "Erreur de connexion : " + err.message;
      }
    })();
  </script>
</body>
</html>
